<!DOCTYPE html>
<html lang="fr">

<head>
    <title>Découverto | Chansons</title>
    <link rel="stylesheet" href="/stylesheets/index-styles.min.css" />
    <link rel="manifest" href="/manifest.json">
    <link href="/favicon.ico" rel="shortcut icon" type="image/x-icon">
    <meta name="theme-color" content="#dc3133">
    <meta name="msapplication-navbutton-color" content="#dc3133">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="utf-8">
    <meta name="description" itemprop="description" content="<%= metas.short_desc %>">
    <meta itemprop="name" content="Découverto | Chansons">
    <meta name="image" itemprop="image" content="https://decouverto.fr/icons/512.png">
    <meta name="og:title" content="Découverto | Chansons">
    <meta name="og:description" content="<%= metas.short_desc %>">
    <meta name="og:url" content="https://decouverto.fr/chansons/">
    <meta name="og:site_name" content="Découverto">
    <meta name="og:locale" content="fr_FR">
    <meta name="fb:admins" content="1803338833217763">
    <meta name="og:type" content="website">
</head>

<body>
    <!-- SVG Symbol definition -->
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
        <symbol id="music-note" viewBox="0 0 24 24">
            <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
        </symbol>
    </svg>
    <%- include('includes/nav', {activePage: 'chansons' }); %>
        <section class="content">
            <h2>Nos Chansons</h2>
            <p style="margin-bottom: 2em;">Découvrez les chansons de l'association Découverto. Ces créations musicales
                accompagnent nos randonnées, célèbrent la nature et le patrimoine local.</p>

            <div class="chansons-cards">
                <% if(songs && songs.length> 0) { %>
                    <% for(var i=0; i<songs.length; i++) { %>
                        <div class="card">
                            <h4 class="title">
                                <svg width="20" height="20" fill="currentColor"
                                    style="vertical-align: middle; margin-right: 0.3em;">
                                    <use href="#music-note" />
                                </svg>
                                <%= songs[i].title %>
                            </h4>
                            <p>
                                <%= songs[i].description %>
                            </p>
                            <audio controls preload="none">
                                <source src="/songs/<%= songs[i].audio %>" type="audio/mpeg">
                                Votre navigateur ne supporte pas l'élément audio.
                            </audio>
                        </div>
                        <% } %>
                            <% } else { %>
                                <div class="card">
                                    <h4 class="title">Aucune chanson disponible</h4>
                                    <p>Les compositions musicales de l'association seront bientôt disponibles.</p>
                                </div>
                                <% } %>
            </div>
        </section>
        <%- include('includes/footer'); %>
            <script type="text/javascript" src="/javascripts/nav/build.js"></script>
</body>

</html>